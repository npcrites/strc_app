{
  "expo": {
    "name": "DashboardApp",
    "slug": "dashboard-app",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "scheme": "strctracker",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dashboardapp.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.dashboardapp.app"
    },
    "web": {
    },
    "extra": {
      "apiUrl": "http://localhost:8000/api",
      "apiUrlDevice": "http://192.168.4.153:8000/api"
    }
  }
}
